<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nexusengine.core</groupId>
    <artifactId>nexus-admin</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>nexus-admin</name>
    <description>NexusCore admin management API</description>

    <parent>
        <groupId>com.nexusengine.core</groupId>
        <artifactId>nexus-core</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>com.nexusengine.core</groupId>
            <artifactId>nexus-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexusengine.core</groupId>
            <artifactId>nexus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nexusengine.core</groupId>
            <artifactId>nexus-ai</artifactId>
        </dependency>
        <!--Spring Cloud AWS S3 for file storage-->
        <dependency>
            <groupId>io.awspring.cloud</groupId>
            <artifactId>spring-cloud-aws-starter-s3</artifactId>
        </dependency>
        <!--MinIO for local S3-compatible storage in dev-->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.squareup.okhttp3</groupId>
                    <artifactId>okhttp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>
        <!--Resilience4j circuit breaker-->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>

        <!--RabbitMQ for product sync events-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
    </dependencies>
    <build>
    </build>
</project>
