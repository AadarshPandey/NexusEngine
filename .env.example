# ==============================================================================
# NexusEngine Environment Configuration Template
# Copy this file to .env and fill in your values: cp .env.example .env
# ==============================================================================

# ─── Application & Profile ────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ─── Security & Authentication ────────────────────────────────────────────────
# Minimum 256-bit (32 bytes) secret for HMAC-SHA256 JWT signing
# Generate a secure secret using: openssl rand -base64 32
JWT_SECRET=nexus-engine-super-secret-jwt-key-for-development-only-change-in-prod-min-32-chars

# ─── Database (PostgreSQL 17 + pgvector) ──────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nexuscore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Cache & Distributed Lock (Redis 8) ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Messaging Broker (RabbitMQ 4) ────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─── Search Engine (Elasticsearch 8+) ─────────────────────────────────────────
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ─── Object Storage (AWS S3 / LocalStack) ─────────────────────────────────────
AWS_S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET_NAME=nexus-media

# ─── Payment Gateway (Razorpay) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ─── AI Assistant (Google Gemini) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Mail / SMTP (OTP & Order Notifications) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
