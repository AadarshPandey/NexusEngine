# ─── Required Secrets (MUST be set before running) ─────────────────────
# Generate JWT secret: openssl rand -base64 48
JWT_SECRET=

# Razorpay API Credentials (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# SMTP Configuration (for OTP emails)
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password

# ─── Optional Overrides ───────────────────────────────────────────────
# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# CORS (production only — set to your frontend domain)
# CORS_ORIGIN=https://your-frontend.com

# MinIO / S3
AWS_ACCESS_KEY=minioadmin
AWS_SECRET_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# OpenAI (for AI chatbot features)
# OPENAI_API_KEY=sk-your-key-here

# Google Gemini (alternative AI provider)
# GEMINI_API_KEY=your-gemini-api-key-here

# Stripe (if using Stripe instead of Razorpay)
# STRIPE_SECRET_KEY=sk_test_your_key_here
